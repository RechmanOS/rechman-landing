---
// src/pages/feed.astro
import '../styles/global.css';
import VideoFeed from '../components/VideoFeed.astro';
import { videos } from '../data/videos';

const ua = Astro.request.headers.get('user-agent') || '';
const isMobile = /Mobile|Android|iPhone|iPod/i.test(ua) && !/iPad|Tablet/i.test(ua);

const title = "Rechman OS — Лента возможностей";
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <style>
      body, html {
        margin: 0; padding: 0; height: 100%; overflow: hidden;
        background-color: #3a0d1b;
      }
    </style>
  </head>
  <body>
    
    <VideoFeed videos={videos} isMobile={isMobile} />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const feed = document.getElementById('video-feed');
        if (!feed) return;

        const isMobile = feed.classList.contains('mobile-feed');
        const slides = Array.from(feed.querySelectorAll('.video-slide'));
        
        const manageVideos = (activeIndex) => {
          slides.forEach((slide, i) => {
            const video = slide.querySelector('video');
            const loader = slide.querySelector('.loader');
            const pauseIcon = slide.querySelector('.pause-overlay');
            if (!video) return;

            if (Math.abs(i - activeIndex) <= 1) {
              if (!video.src || video.src === '') {
                video.src = video.dataset.src;
              }
              
              video.addEventListener('waiting', () => loader.classList.add('visible'));
              video.addEventListener('playing', () => {
                loader.classList.remove('visible');
                pauseIcon.classList.remove('visible'); // Скрываем паузу
              });
              video.addEventListener('canplay', () => loader.classList.remove('visible'));

              if (i === activeIndex) {
                if (!video.dataset.userPaused) {
                  video.play().catch((e) => console.log('Autoplay blocked:', e));
                } else {
                  // Если пользователь поставил на паузу, показываем иконку
                  pauseIcon.classList.add('visible');
                }
              } else {
                video.pause();
                video.dataset.userPaused = ''; 
                pauseIcon.classList.remove('visible');
              }
            } else {
              if (video.src && video.src !== '') {
                video.pause();
                video.removeAttribute('src');
                video.load(); 
                loader.classList.remove('visible');
                pauseIcon.classList.remove('visible');
              }
            }
          });
        };

        const observerOptions = { root: null, rootMargin: '0px', threshold: 0.6 };
        let currentActiveIndex = 0;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const index = parseInt(entry.target.getAttribute('data-index'));
              if (!isNaN(index)) {
                currentActiveIndex = index;
                manageVideos(currentActiveIndex);
              }
            }
          });
        }, observerOptions);
        
        slides.forEach((slide) => observer.observe(slide));
        setTimeout(() => manageVideos(0), 100);

        slides.forEach((slide) => {
          const video = slide.querySelector('video');
          const videoMask = slide.querySelector('.video-mask');
          const pauseIcon = slide.querySelector('.pause-overlay');
          const backdrop = slide.querySelector('.sheet-backdrop');
          
          const btnSound = slide.querySelector('.btn-sound');
          const btnLike = slide.querySelector('.btn-like');
          const likeCount = slide.querySelector('.like-count');
          const btnShare = slide.querySelector('.btn-share');
          const btnComment = slide.querySelector('.btn-comment');
          const btnDescOpen = slide.querySelector('.btn-desc-open');
          const bigHeart = slide.querySelector('.big-heart');

          const shareSheet = slide.querySelector('.share-sheet');
          const descSheet = slide.querySelector('.desc-sheet');
          const commentsSheet = slide.querySelector('.comments-sheet');

          const videoId = slide.getAttribute('data-id');
          const shareUrl = window.location.origin + '/feed?v=' + videoId;

          const closeAllSheets = () => {
            shareSheet.classList.remove('is-open');
            descSheet.classList.remove('is-open');
            commentsSheet.classList.remove('is-open');
            backdrop.classList.remove('is-visible');
            if (video && video.src && !video.dataset.userPaused) video.play();
          };

          slide.querySelectorAll('.close-sheet').forEach(btn => btn.addEventListener('click', (e) => { e.stopPropagation(); closeAllSheets(); }));
          backdrop.addEventListener('click', closeAllSheets);

          if (btnSound) {
            btnSound.addEventListener('click', (e) => {
              e.stopPropagation();
              if (!video.src) return;
              video.muted = !video.muted;
              btnSound.classList.toggle('is-unmuted', !video.muted);
            });
          }

          if (btnLike) {
            let isLiked = false;
            btnLike.addEventListener('click', (e) => {
              e.stopPropagation();
              isLiked = !isLiked;
              btnLike.classList.toggle('is-liked', isLiked);
              likeCount.textContent = isLiked ? '1' : '0';
            });
          }

          // --- ЛОГИКА ТАПА (ПАУЗА/ЛАЙК) ---
          let lastTap = 0;
          videoMask.addEventListener('click', (e) => {
            const currentTime = new Date().getTime();
            const tapLength = currentTime - lastTap;
            
            if (tapLength < 300 && tapLength > 0) {
              e.preventDefault();
              if (!btnLike.classList.contains('is-liked')) btnLike.click();
              bigHeart.classList.remove('animate');
              void bigHeart.offsetWidth;
              bigHeart.classList.add('animate');
              
              if (video.paused && video.src) {
                video.dataset.userPaused = ''; 
                video.play().catch(()=>{});
                pauseIcon.classList.remove('visible');
              }
            } else {
              setTimeout(() => {
                const currentTimeAfterDelay = new Date().getTime();
                if (currentTimeAfterDelay - currentTime > 250) {
                  if (video.paused) {
                    video.dataset.userPaused = ''; 
                    video.play().catch(()=>{});
                    pauseIcon.classList.remove('visible');
                  } else {
                    video.dataset.userPaused = 'true'; 
                    video.pause();
                    pauseIcon.classList.add('visible'); // Показываем иконку
                  }
                }
              }, 250);
            }
            lastTap = currentTime;
          });

          btnDescOpen.addEventListener('click', (e) => {
            e.stopPropagation();
            descSheet.classList.add('is-open');
            backdrop.classList.add('is-visible');
            if (video && video.src) video.pause();
          });

          btnComment.addEventListener('click', (e) => {
            e.stopPropagation();
            commentsSheet.classList.add('is-open');
            backdrop.classList.add('is-visible');
            if (video && video.src) video.pause();
          });

          btnShare.addEventListener('click', (e) => {
            e.stopPropagation();
            shareSheet.classList.add('is-open');
            backdrop.classList.add('is-visible');
            if (video && video.src) video.pause();
          });

          const btnTg = slide.querySelector('.btn-tg');
          const btnMax = slide.querySelector('.btn-max');
          const btnCopy = slide.querySelector('.btn-copy');

          if (btnTg) btnTg.href = `https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=Смотрите это видео на Rechman OS`;
          if (btnMax) btnMax.href = `https://max.ru/share?url=${encodeURIComponent(shareUrl)}`;
          
          if (btnCopy) {
            btnCopy.addEventListener('click', () => {
              navigator.clipboard.writeText(shareUrl).then(() => {
                btnCopy.textContent = 'Скопировано!';
                setTimeout(() => btnCopy.textContent = 'Скопировать ссылку', 2000);
              });
            });
          }
        });

        if (!isMobile) {
          let ticking = false;
          const updateActiveSlide = () => {
            const feedRect = feed.getBoundingClientRect();
            const feedCenter = feedRect.left + feedRect.width / 2;
            let closestSlide = null;
            let minDistance = Infinity;
            let closestIndex = -1;

            for (let i = 0; i < slides.length; i++) {
              const slide = slides[i];
              const slideRect = slide.getBoundingClientRect();
              const slideCenter = slideRect.left + slideRect.width / 2;
              const distance = Math.abs(feedCenter - slideCenter);
              if (distance < minDistance) {
                minDistance = distance;
                closestSlide = slide;
                closestIndex = i;
              }
            }

            for (let i = 0; i < slides.length; i++) slides[i].classList.remove('is-active');
            if (closestSlide !== null) {
              closestSlide.classList.add('is-active');
              if (closestIndex !== -1 && closestIndex !== currentActiveIndex) {
                currentActiveIndex = closestIndex;
                manageVideos(currentActiveIndex);
              }
            }
            ticking = false;
          };

          feed.addEventListener('scroll', () => {
            if (!ticking) {
              window.requestAnimationFrame(updateActiveSlide);
              ticking = true;
            }
          });
          setTimeout(updateActiveSlide, 500);

          let isDown = false;
          let startX = 0;
          let scrollLeft = 0;

          feed.addEventListener('mousedown', (e) => {
            if (e.target.closest('.action-btn') || e.target.closest('.bottom-sheet') || e.target.closest('.btn-desc-open') || e.target.closest('.btn-contact')) return;
            if (e.button !== 0) return; 
            isDown = true;
            feed.classList.add('active-drag');
            startX = e.clientX - feed.offsetLeft;
            scrollLeft = feed.scrollLeft;
            e.preventDefault(); 
          });

          window.addEventListener('mouseup', () => {
            isDown = false;
            feed.classList.remove('active-drag');
          });

          window.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.clientX - feed.offsetLeft;
            const walk = (x - startX) * 1.5; 
            feed.scrollLeft = scrollLeft - walk;
          });
          
          feed.addEventListener('dragstart', (e) => e.preventDefault());
        }
      });
    </script>
  </body>
</html>