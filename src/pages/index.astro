---
import '../styles/global.css';
import 'swiper/css';

// --- БЛОК ДАННЫХ ---
const fundamentals = [
	{ id: 1, title: "Концептуальный сдвиг парадигмы", desc: "Переход от схемы «люди управляют процессами (и ошибаются, болеют, выгорают)» к схеме «RECHMAN OS — беспристрастный Автономный Операционный Руководитель и Дирижер процессов». Люди лишь четко выполняют функции по фиксированному пайплайну.", video: "/videos/fund1.mp4" },
	{ id: 2, title: "Мягкое внедрение системы", desc: "Принцип «не навреди» и «польза раньше обязанности». Внедрение происходит без отвлечения сотрудников от основных бизнес процессов, не требует привлечения сторонних консультантов, подстраивается под любые уже существующие регламенты процессов.", video: "/videos/fund2.mp4" },
	{ id: 3, title: "Независимость от «незаменимых»", desc: "Знания, регламенты и клиентские цепочки больше не хранятся в головах отдельного персонала. При уходе ключевого специалиста бизнес продолжает работать без сбоев.", video: "/videos/fund3.mp4" },
	{ id: 4, title: "Мгновенный онбординг", desc: "Ввод в должность за 1 день. Новые сотрудники не сжигают лиды и не совершают ошибок — система ведет их за руку по пошаговому пайплайн-чеклисту («Что сделать дальше»).", video: "/videos/fund4.mp4" },
	{ id: 5, title: "Объективный арбитр", desc: "RECHMAN OS фиксирует 100% цифровых следов и фактов (время, действия, документы, параметры). Любой спор внутри компании или с контрагентом разбирается мгновенно на основе объективных данных, а не эмоций.", video: "/videos/fund5.mp4" },
	{ id: 6, title: "Реальный KPI", desc: "Теперь не проблема, система ведет беспристрастный хронометраж всех действий, моментально подсвечивая реальный результат каждого человека, скрытые простои и перегрузки.", video: "/videos/fund6.mp4" },
	{ id: 7, title: "Голосовой интерфейс ввода", desc: "Voice-to-Text. Надиктовывание команд, задач, первичных данных и комментариев на живом языке без мучительного набора на клавиатуре. Поддержка многозадачности и контекстов, система сама определяет к какой именно из текущих задач относится то что сказал сотрудник.", video: "/videos/fund7.mp4" },
	{ id: 8, title: "Самообучение", desc: "Система сосредоточена на достижении поставленной сотрудником задачи, в случае недостаточности сведений для выполнения задачи система задает вопросы, направленные на выявление регламента достижения цели. После прохождения по всем этапам нового регламента, он внедряется для дальнейшего использования. Любое поручение доводится до требуемого результата.", video: "/videos/fund8.mp4" },
	{ id: 9, title: "Наглядный вывод", desc: "Система выводит аккуратные текстовые дашборды, наглядные карточки, таблицы, графики и пуш-уведомления (система понимает речь, но сама общается исключительно строгим текстом/интерфейсом).", video: "/videos/fund9.mp4" },
	{ id: 10, title: "100% On-Premise безопасность", desc: "Локальное развертывание ядра на сервере. Система поставляется как ПАК состоящий из SOFT+HARD. Коммерческая тайна, базы данных и аналитика никогда не передаются в сторонние публичные облака. Система фиксирует каждое событие на каждом шаге и ведет непрерывный цифровой журнал всех транзакций. При любом жестком сбое ядро мгновенно откатывается к последней стабильной точке и восстанавливает всё до мельчайших деталей. Едва восстановившись, RECHMAN OS самостоятельно воссоздает всю цепочку событий, рассылает всем сотрудникам их точные статусы и указывает, что именно нужно подхватить прямо сейчас.", video: "/videos/fund10.mp4" },
	{ id: 11, title: "Авторизация по HWID", desc: "Жесткий доступ к системе только с зарегистрированных и доверенных устройств Whitelist, шифрование данных по ГОСТ, использование хеш-функции, ассиметричные шлюзы, тестовая песочница для входных данных.", video: "/videos/fund11.mp4" },
	{ id: 12, title: "Работа с подрядчиками", desc: "Все внешние сотрудники работают в отдельных кабинетах. Они видят жесткие таймлайны, получают новые задачи, согласовывают изменения в проектах, получают уведомления и штрафы за просрочки, делают запросы на поставку материалов и комплектующих, получают акты и сверки, ведут весь документооборот по проекту.", video: "/videos/fund12.mp4" },
	{ id: 13, title: "Бесшовность с 1С и ЭДО", desc: "Интеграция поверх существующей инфраструктуры без изменения и нарушения исходного кода 1С. После полного внедрения системы в деятельность компании появляется возможность полностью отказаться от 1С.", video: "/videos/fund13.mp4" },
	{ id: 14, title: "Глубокая аналитика", desc: "После полного внедрения системы, появляется функция глубокой аналитики каждого из процессов, протекающих в компании. Система находит узкие места и предлагает оптимизацию процессов для ускорения и снижения нагрузки на сотрудников, что дает повышение производительности на min 50%.", video: "/videos/fund14.mp4" },
	{ id: 15, title: "Две сущности", desc: "Первая сущность помогающая, она снабжает сотрудника всем необходимым для его работы, вторая сущность контролирующая, она стимулирует сотрудника оставаться в таймлайне. Руководитель может регулировать жесткость контролирующей сущности.", video: "/videos/fund15.mp4" }
];

const roles = [
	{ icon: "👑", title: "CEO", desc: "Для СЕО, система дает возможность получать любой отчет за считанные секунды, достаточно просто спросить голосом. Руководитель может внедрять новые регламенты просто надиктовав голосом поручение и далее подтвердив нажатием кнопки, после чего все причастные получат необходимые распоряжения." },
	{ icon: "👨‍💻", title: "Сотрудники", desc: "Для сотрудников, система дает возможность вносить любые данные голосом либо фотографировать любой документ, и вся информация ляжет в нужные места системы учета. Также голосом можно составлять документы, например, договора, счета, КП, сметы и т.д." },
	{ icon: "📦", title: "Склад", desc: "Для склада, система следит за адресным хранением, сроком годности FEFO, складскими остатками, инвентаризацией, и любыми другими показателями, которые необходимы сотрудникам, отслеживание партийности серийности, работа с маркировкой «Честный знак» ЕГИСЗ и другими реестрами. Считывание QR-кодов и штрихкодов, OCR-сканер: возможность фотографировать любые бумажные документы (накладные, акты) с автопереводом их в данные для заполнения в системе учета." },
	{ icon: "💰", title: "Фин. директор", desc: "Для Фин. директора, система анализирует график выплат, дебиторку, запасы, товары в пути, ФОТ, налоги, оценивает план продаж опираясь на аналитику аналогичного периода, при угрозе кассового разрыва она выдает пошаговый план спасения: кому дать скидку за срочный расчет, а чей платеж сдвинуть без штрафа. Система контролирует обязательные выплаты и заранее ставит их в график платежей, рассчитывает налоги и ФОТ." },
	{ icon: "📞", title: "Менеджеры по продажам", desc: "Для менеджеров по продажам, система настоящий невидимый наставник. Прямо вовремя звонка система слушает диалог и выводит на экран продавца нужные реплики, реперные точки, ответы на возражения, подсказывает товары, которые прямо сейчас выгодно предложить со скидкой именно этому покупателю. Проводит новичка по скрипту продаж." },
	{ icon: "📊", title: "РОП", desc: "Для РОП, встроенный алгоритм разбирает каждый звонок менеджера по продажам на смысловые блоки и выдает наглядную картину: озвучена ли цена, отработано ли возражение, соблюдены ли стандарты, пройдены ли все заданные руководителем реперные точки. Возможность получить любой отчет по любым критериям за считанные секунды." },
	{ icon: "🛒", title: "Менеджер по закупкам", desc: "Для менеджера по закупкам, система сама собирает лучшие цены и альтернативных поставщиков с рынка, запрашивает счета и КП, ведет переписку, обзванивает поставщиков по скриптам, делает сверки, отслеживает кредиторку. Автозаказ сырья и комплектующих на основе динамики продаж." },
	{ icon: "📑", title: "Тендерный отдел", desc: "Тендерному отделу, система анализирует все площадки, и сама находит самые выгодные закупки, аудирует ваши шансы, обучается составлять конкурсную документацию с хитроумными критериями, идеально подсвечивающими именно ваши плюсы, готовит всю документация согласно ГОСТ и ФЗ." },
	{ icon: "⚖️", title: "Юридический отдел", desc: "Юридическому отделу, система готовит документы строго в соответствии с законодательством, требованием ГОСТ/ISO и других регламентирующих актов, а также прогоняет договоры через массив арбитражной практики, моментально подсвечивая опасные формулировки и прицеденты." },
	{ icon: "🤝", title: "HR специалист", desc: "HR специалисту, авторасчет премий, анализ хронометража операций и выявление «узких мест» по конкретным сотрудникам и отделам + выдача конкретных рекомендаций и готовых решений по устранению создавшихся узких мест. Обучение новых сотрудников с помощью подсказок и пошаговых инструкций. Работа с сайтами по поиску сотрудников, проведение первоначальных собеседований и тестирований." },
	{ icon: "⚙️", title: "Доработки", desc: "Возможны любые доработки под ваши задачи, например работа с CAE и CAD системами, управление спецификациями и PLM, работа с технологическими картами на производстве, работа с ЧПУ линиями, работа с приборами ОТК, ведение R&D проектов, патентный поиск и подготовка заявок, поддержка и ведение лабораторных исследований, поддержка ISO 9001 и т.д." }
];
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>Rechman OS — Автономный Операционный Руководитель</title>
		<style>
			/* Анимация плавного появления окна */
			dialog[open] { animation: modal-pop 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
			@keyframes modal-pop { from { opacity: 0; transform: scale(0.9) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }
			dialog::backdrop { background-color: rgba(15, 23, 42, 0.8); backdrop-filter: blur(4px); }

			/* Стили для парящих иконок поверх видео */
			.hero-icon {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 60px;
				height: 60px;
				background: rgba(30, 41, 59, 0.8);
				backdrop-filter: blur(8px);
				border-radius: 16px;
				font-size: 30px;
				box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.5);
				border: 1px solid rgba(59, 130, 246, 0.3);
				will-change: transform, opacity;
				opacity: 0; 
				transform: translateY(20px);
				transition: opacity 0.6s ease, transform 0.6s ease;
				animation: float 4s ease-in-out infinite;
			}
			
			.hero-icon.visible {
				opacity: 1;
				transform: translateY(0);
			}

			@media (min-width: 768px) {
				.hero-icon { width: 80px; height: 80px; font-size: 40px; border-radius: 24px; }
			}
			@keyframes float {
				0% { transform: translateY(0px); }
				50% { transform: translateY(-15px); }
				100% { transform: translateY(0px); }
			}

			/* Добавляем свечение для логотипа, чтобы темный текст был виден */
			.logo-glow {
				filter: drop-shadow(0px 0px 20px rgba(59, 130, 246, 0.6)) drop-shadow(0px 0px 40px rgba(59, 130, 246, 0.3));
			}
		</style>
	</head>
	<body class="bg-slate-900 text-white font-sans min-h-screen flex flex-col m-0 selection:bg-blue-500 selection:text-white">
		
		<main class="flex-grow flex flex-col items-center p-0 m-0 space-y-0 pb-20">
			
			<!-- ГЛАВНЫЙ ЭКРАН (Кинотеатр с вертикальным видео) -->
			<section class="relative w-full h-[100svh] overflow-hidden bg-slate-950 flex items-center justify-center">
				
				<!-- Контейнер для видео формата 9:16 -->
				<div class="relative w-full h-full md:h-[100svh] md:w-auto md:aspect-[9/16] overflow-hidden bg-slate-950 shadow-2xl">
					
					<!-- Само видео -->
					<video 
						id="heroVideo" 
						class="absolute inset-0 w-full h-full object-cover opacity-70" 
						playsinline 
						muted 
						autoplay
						poster="https://images.unsplash.com/photo-1519389950473-47ba0277781c?q=80&w=1920&auto=format&fit=crop"
						src="/videos/hero.mp4">
					</video>

					<!-- Иконки -->
					<div class="absolute inset-0 pointer-events-none z-10">
						<div id="icon1" class="hero-icon absolute top-[20%] left-[10%]">📊</div>
						<div id="icon2" class="hero-icon absolute top-[30%] right-[10%]">🧠</div>
						<div id="icon3" class="hero-icon absolute bottom-[35%] left-[15%]">🎙️</div>
						<div id="icon4" class="hero-icon absolute bottom-[25%] right-[15%]">⚙️</div>
					</div>

					<!-- Блюр -->
					<div id="heroBlur" class="absolute inset-0 bg-slate-900/0 backdrop-blur-none transition-all duration-1000 z-20 pointer-events-none"></div>

					<!-- Логотип и текст -->
					<div id="heroLogo" class="absolute inset-0 flex flex-col items-center justify-center opacity-0 transition-opacity duration-1000 z-30 pointer-events-none px-4 text-center">
						<!-- Логотип увеличен до 600px -->
						<img src="/logo.png" alt="RECHMAN OS" class="logo-glow w-[95%] max-w-[600px] object-contain mb-4" />
						
						<!-- Основной подзаголовок -->
						<p class="text-sm md:text-lg text-slate-200 font-medium tracking-widest uppercase">
							Автономный операционный руководитель
						</p>
						
						<!-- Новая строка -->
						<p class="text-xs md:text-base text-slate-300 mt-2 font-medium tracking-widest uppercase">
							Управление голосом
						</p>
					</div>

				</div>
			</section>

			<!-- БЛОК 1: ФУНДАМЕНТАЛЬНЫЕ ОСНОВЫ -->
			<section id="fundamentals" class="w-full max-w-6xl scroll-mt-24 px-6 mt-24">
				<h2 class="text-3xl font-bold mb-10 text-center text-slate-200">Философия и фундамент</h2>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{fundamentals.map((item) => (
						<div class="bg-slate-800 rounded-xl p-6 border border-slate-700 flex flex-col justify-between hover:border-blue-500 transition-colors shadow-lg">
							<div>
								<div class="text-blue-400 font-bold mb-2">0{item.id}</div>
								<h3 class="text-xl font-bold mb-3">{item.title}</h3>
								<p class="text-slate-400 text-sm mb-6">{item.desc}</p>
							</div>
							<button onclick={`openVideo('${item.video}')`} class="bg-slate-700 hover:bg-blue-600 text-white font-medium py-2 px-4 rounded-lg w-full transition-colors flex items-center justify-center gap-2">
								▶ Смотреть видео
							</button>
						</div>
					))}
				</div>
			</section>

			<!-- БЛОК 2: БЕСКОНЕЧНАЯ КАРУСЕЛЬ РОЛЕЙ -->
			<section id="roles" class="w-full max-w-6xl scroll-mt-24 overflow-hidden mt-24 px-6">
				<h2 class="text-3xl font-bold mb-10 text-center text-slate-200">Польза для бизнеса</h2>
				
				<div class="swiper mySwiper pb-12">
					<div class="swiper-wrapper">
						{roles.map((role) => (
							<div class="swiper-slide h-auto">
								<div class="bg-slate-800 rounded-xl p-8 border border-slate-700 flex flex-col items-center justify-center text-center cursor-pointer hover:bg-slate-700 hover:-translate-y-2 hover:border-blue-500 transition-all duration-300 shadow-lg h-full" 
									 onclick={`openRole('${role.icon}', '${role.title}', '${role.desc.replace(/'/g, "\\'")}')`}>
									<div class="text-6xl mb-4">{role.icon}</div>
									<h3 class="text-xl font-bold text-slate-100">{role.title}</h3>
									<span class="text-blue-400 text-sm font-medium mt-4 opacity-0 hover:opacity-100 transition-opacity">Подробнее →</span>
								</div>
							</div>
						))}
					</div>
					<div class="swiper-pagination !-bottom-0"></div>
				</div>
			</section>

			<!-- БЛОК 3: ФОРМА СБОРА ЗАЯВОК -->
			<section id="contact" class="w-full max-w-2xl scroll-mt-24 bg-slate-800 p-8 rounded-2xl border border-slate-700 shadow-2xl mt-24 mx-6">
				<div class="text-center mb-8">
					<h2 class="text-3xl font-bold mb-2 text-slate-100">Запросить демонстрацию</h2>
					<p class="text-slate-400">Оставьте контакты, и мы покажем вам возможности системы.</p>
				</div>
				
				<form id="leadForm" class="space-y-4">
					<div>
						<label class="block text-sm font-medium text-slate-300 mb-1">Ваше имя</label>
						<input type="text" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="Иван Иванов" />
					</div>
					<div>
						<label class="block text-sm font-medium text-slate-300 mb-1">Телефон или Email</label>
						<input type="text" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="+7 (999) 123-45-67" />
					</div>
					<div>
						<label class="block text-sm font-medium text-slate-300 mb-1">Компания</label>
						<input type="text" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="ООО Ромашка" />
					</div>
					<button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-4 rounded-lg shadow-lg shadow-emerald-500/30 transition-all mt-4">
						Отправить заявку
					</button>
				</form>
			</section>

		</main>

		<!-- МОДАЛЬНЫЕ ОКНА -->
		<dialog id="videoModal" class="bg-transparent p-0 m-auto w-full max-w-4xl rounded-xl overflow-hidden shadow-2xl">
			<div class="bg-slate-900 border border-slate-700 p-2 sm:p-4 relative">
				<button onclick="closeVideo()" class="absolute top-4 right-4 text-white hover:text-red-400 font-bold text-xl z-10 bg-black/50 w-10 h-10 rounded-full flex items-center justify-center transition-colors">✕</button>
				<video id="videoPlayer" controls class="w-full rounded-lg aspect-video bg-black">
					<source id="videoSource" src="" type="video/mp4">
				</video>
			</div>
		</dialog>

		<dialog id="roleModal" class="bg-transparent p-0 m-auto w-full max-w-lg rounded-2xl overflow-hidden shadow-2xl">
			<div class="bg-slate-800 border-2 border-blue-500/50 p-8 relative rounded-2xl flex flex-col items-center max-h-[85vh] overflow-y-auto">
				<button onclick="closeRole()" class="absolute top-4 right-4 text-slate-400 hover:text-white bg-slate-700 w-8 h-8 rounded-full flex items-center justify-center font-bold transition-colors">✕</button>
				<div id="roleIcon" class="text-6xl mb-4 drop-shadow-lg"></div>
				<h3 id="roleTitle" class="text-2xl font-bold mb-4 text-slate-100 text-center"></h3>
				<div class="w-full h-px bg-slate-700 mb-6"></div>
				<p id="roleDesc" class="text-slate-300 leading-relaxed text-left text-base"></p>
			</div>
		</dialog>

		<footer class="p-6 text-center text-sm text-slate-500 border-t border-slate-800">
			<p>© 2026 RECHMAN OS. Все права защищены.</p>
		</footer>

		<script>
			// @ts-nocheck
			// --- Логика видео-презентации ---
			const heroVideo = document.getElementById('heroVideo');
			const icons = [
				document.getElementById('icon1'),
				document.getElementById('icon2'),
				document.getElementById('icon3'),
				document.getElementById('icon4')
			];
			const heroBlur = document.getElementById('heroBlur');
			const heroLogo = document.getElementById('heroLogo');

			if (heroVideo) {
				// Блокировка повторного воспроизведения при скролле
				let hasPlayed = false;
				heroVideo.addEventListener('play', () => {
					if (hasPlayed) heroVideo.pause();
					hasPlayed = true;
				});

				heroVideo.play().catch(e => console.log("Autoplay blocked:", e));

				heroVideo.addEventListener('timeupdate', () => {
					const time = heroVideo.currentTime;

					if (time >= 3.0) icons[0].classList.add('visible');
					if (time >= 3.5) icons[1].classList.add('visible');
					if (time >= 4.0) icons[2].classList.add('visible');
					if (time >= 4.5) icons[3].classList.add('visible');

					if (time >= 6.0) {
						heroBlur.classList.remove('bg-slate-900/0', 'backdrop-blur-none');
						heroBlur.classList.add('bg-slate-900/60', 'backdrop-blur-md');
					}

					if (time >= 8.0) {
						heroLogo.classList.remove('opacity-0');
						heroLogo.classList.add('opacity-100');
					}
				});

				heroVideo.addEventListener('ended', () => {
					icons.forEach(icon => icon.classList.add('visible'));
					heroBlur.classList.remove('bg-slate-900/0', 'backdrop-blur-none');
					heroBlur.classList.add('bg-slate-900/60', 'backdrop-blur-md');
					heroLogo.classList.remove('opacity-0');
					heroLogo.classList.add('opacity-100');
				});
			}

			// --- Инициализация Swiper ---
			import Swiper from 'swiper';
			import { Autoplay, Pagination } from 'swiper/modules';

			const mySwiper = new Swiper('.mySwiper', {
				modules: [Autoplay, Pagination],
				loop: true,
				slidesPerView: 1,
				spaceBetween: 24,
				grabCursor: true,
				autoplay: { delay: 3000, disableOnInteraction: false },
				pagination: { el: '.swiper-pagination', clickable: true },
				breakpoints: { 640: { slidesPerView: 1 }, 768: { slidesPerView: 2 }, 1024: { slidesPerView: 3 } }
			});

			// --- Логика модальных окон ---
			const videoModal = document.getElementById('videoModal');
			const videoPlayer = document.getElementById('videoPlayer');
			const videoSource = document.getElementById('videoSource');

			window.openVideo = (path) => {
				videoSource.src = path; 
				videoPlayer.load(); 
				videoModal.showModal(); 
			};
			window.closeVideo = () => {
				videoModal.close();
				videoPlayer.pause();
				videoPlayer.currentTime = 0;
			};

			const roleModal = document.getElementById('roleModal');
			const roleIcon = document.getElementById('roleIcon');
			const roleTitle = document.getElementById('roleTitle');
			const roleDesc = document.getElementById('roleDesc');

			window.openRole = (icon, title, desc) => {
				roleIcon.textContent = icon;
				roleTitle.textContent = title;
				roleDesc.textContent = desc;
				mySwiper.autoplay.stop(); 
				roleModal.showModal();
			};
			
			window.closeRole = () => { 
				roleModal.close(); 
				mySwiper.autoplay.start(); 
			};

			roleModal.addEventListener('close', () => {
				mySwiper.autoplay.start();
			});

			// --- Логика формы (Безопасная отправка) ---
			const leadForm = document.getElementById('leadForm');
			const submitBtn = leadForm.querySelector('button[type="submit"]');

			leadForm.addEventListener('submit', async (e) => {
				e.preventDefault(); 
				
				const originalText = submitBtn.textContent;
				submitBtn.textContent = 'Отправка...';
				submitBtn.disabled = true;

				const name = leadForm.querySelector('input[type="text"]').value;
				const contact = leadForm.querySelectorAll('input[type="text"]')[1].value; 
				const companyInput = leadForm.querySelectorAll('input[type="text"]')[2];
				const company = companyInput ? companyInput.value : 'Не указана';

				try {
					const response = await fetch('/api/send-lead', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ name, contact, company })
					});

					const data = await response.json();

					if (response.ok) {
						alert('Спасибо! Ваша заявка отправлена. Мы свяжемся с вами в ближайшее время.');
						leadForm.reset(); 
					} else {
						alert('ОШИБКА: ' + (data.error || 'Неизвестная ошибка'));
					}
				} catch (error) {
					alert('Ошибка сети: ' + error.message);
				} finally {
					submitBtn.textContent = originalText;
					submitBtn.disabled = false;
				}
			});
		</script>
	</body>
</html>