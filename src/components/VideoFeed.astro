---
// @ts-nocheck
// src/components/VideoFeed.astro
import type { VideoItem } from '../data/videos';

interface Props {
  videos: VideoItem[];
  isMobile: boolean;
}

const { videos, isMobile } = Astro.props;
---

<div id="video-feed" class={`video-feed ${isMobile ? 'mobile-feed' : 'desktop-feed'}`}>
  {videos.map((video, index) => (
    <div class="video-slide" data-id={video.id} data-index={index}>
      
      <!-- Видео -->
      <video
        class="slide-video"
        src={video.src}
        loop
        muted
        playsinline
        autoplay
        preload="metadata"
        draggable="false"
        disablePictureInPicture
        controlsList="nodownload noplaybackrate nofullscreen"
      ></video>

      <!-- Невидимый щит для перетаскивания и двойного клика -->
      <div class="video-mask"></div>

      <!-- Большое сердце для анимации двойного тапа -->
      <div class="big-heart">
        <svg viewBox="0 0 24 24" fill="#ff4d4d" stroke="#ff4d4d" stroke-width="1" width="100" height="100">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </div>

      <!-- Стрелочка внизу для открытия описания (удобно на ПК) -->
      <button class="btn-desc-open" aria-label="Описание">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </button>

      <!-- Правая панель действий -->
      <div class="action-rail">
        <button class="action-btn btn-sound" aria-label="Включить звук">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path class="sound-wave" d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            <path class="sound-wave" d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
            <line class="sound-cross" x1="23" y1="9" x2="17" y2="15" stroke="#ff4d4d"></line>
            <line class="sound-cross" x1="17" y1="9" x2="23" y2="15" stroke="#ff4d4d"></line>
          </svg>
        </button>

        <button class="action-btn btn-like" aria-label="Нравится">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="action-count like-count">0</span>
        </button>

        <button class="action-btn btn-comment" aria-label="Комментарии">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span class="action-count">{video.comments.length}</span>
        </button>

        <button class="action-btn btn-share" aria-label="Поделиться">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
        </button>

        <a href="/docs" class="action-btn btn-info" aria-label="Подробнее">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
        </a>
      </div>

      <div class="video-info">
        <h3>{video.title}</h3>
      </div>

      <!-- ШТОРКА: КОММЕНТАРИИ -->
      <div class="bottom-sheet comments-sheet">
        <div class="sheet-header">
          <h4>Комментарии ({video.comments.length})</h4>
          <button class="close-sheet">✕</button>
        </div>
        <div class="sheet-body">
          {video.comments.map(c => (
            <div class="comment-item">
              <span class="comment-author">{c.author}</span>
              <p class="comment-text">{c.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- ШТОРКА: ОПИСАНИЕ -->
      <div class="bottom-sheet desc-sheet">
        <div class="sheet-header">
          <h4>{video.title}</h4>
          <button class="close-sheet">✕</button>
        </div>
        <div class="sheet-body">
          <p class="desc-text">{video.description}</p>
        </div>
      </div>

      <!-- ШТОРКА: ПОДЕЛИТЬСЯ -->
      <div class="bottom-sheet share-sheet">
        <div class="sheet-header">
          <h4>Поделиться</h4>
          <button class="close-sheet">✕</button>
        </div>
        <div class="sheet-body share-buttons">
          <a href="#" class="share-btn btn-tg" target="_blank">Telegram</a>
          <a href="#" class="share-btn btn-max" target="_blank">MAX</a>
          <button class="share-btn btn-copy">Скопировать ссылку</button>
        </div>
      </div>

      <!-- Задний фон для всех шторок -->
      <div class="sheet-backdrop"></div>

    </div>
  ))}
</div>

<style>
  .video-feed {
    height: 100dvh;
    background: #3a0d1b;
    overscroll-behavior-y: contain;
  }

  .video-slide {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slide-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    -webkit-media-controls: none !important;
  }

  .video-mask {
    position: absolute;
    inset: 0;
    z-index: 10;
    cursor: grab;
    pointer-events: auto;
  }

  .desktop-feed.active-drag .video-mask {
    cursor: grabbing;
  }

  /* --- БОЛЬШОЕ СЕРДЦЕ --- */
  .big-heart {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0);
    z-index: 50;
    pointer-events: none;
    opacity: 0;
    filter: drop-shadow(0 0 20px rgba(255, 77, 77, 0.6));
  }

  .big-heart.animate {
    animation: heart-pop 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  @keyframes heart-pop {
    0% { transform: translate(-50%, -50%) scale(0); opacity: 1; }
    50% { transform: translate(-50%, -50%) scale(1.2); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(1); opacity: 0; }
  }

  /* --- КНОПКА ОПИСАНИЯ --- */
  .btn-desc-open {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(4px);
    pointer-events: auto;
    transition: background 0.2s;
  }

  .btn-desc-open:hover { background: rgba(255,255,255,0.4); }

  /* --- ПРАВАЯ ПАНЕЛЬ --- */
  .action-rail {
    position: absolute;
    right: 12px;
    bottom: 100px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    z-index: 20;
  }

  .action-btn {
    background: none;
    border: none;
    padding: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: transform 0.2s ease;
    pointer-events: auto;
    text-decoration: none;
  }

  .action-btn:hover { transform: scale(1.1); }

  .btn-sound .sound-wave { display: none; }
  .btn-sound .sound-cross { display: block; }
  .btn-sound.is-unmuted .sound-wave { display: block; }
  .btn-sound.is-unmuted .sound-cross { display: none; }

  .btn-like.is-liked svg { fill: #ff4d4d; stroke: #ff4d4d; }
  .btn-like.is-liked { animation: heart-pop-small 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
  @keyframes heart-pop-small { 0% { transform: scale(1); } 50% { transform: scale(1.3); } 100% { transform: scale(1); } }

  .action-count {
    color: white;
    font-size: 14px;
    font-weight: 700;
    text-shadow: 0 1px 3px rgba(0,0,0,0.8);
  }

  .video-info {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    color: white;
    z-index: 20;
    pointer-events: none;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  }

  .video-info h3 { margin: 0; font-size: 1.5rem; font-weight: 700; }

  /* --- ШТОРКИ --- */
  .bottom-sheet {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    max-height: 70%;
    background: #f7f5f0;
    color: #3a0d1b;
    border-radius: 24px 24px 0 0;
    z-index: 100;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    pointer-events: auto;
  }

  .bottom-sheet.is-open { transform: translateY(0); }

  .sheet-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }

  .sheet-header h4 { margin: 0; font-size: 1.25rem; }

  .close-sheet {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: #3a0d1b;
  }

  .sheet-body {
    padding: 1.5rem;
    overflow-y: auto;
    flex: 1;
  }

  .comment-item { margin-bottom: 1rem; font-size: 0.95rem; }
  .comment-author { font-weight: 700; display: block; margin-bottom: 4px; }
  .comment-text { margin: 0; line-height: 1.4; }

  .desc-text { font-size: 1rem; line-height: 1.6; margin: 0; }

  /* Кнопки шаринга */
  .share-buttons { display: flex; flex-direction: column; gap: 12px; }
  .share-btn {
    display: block; width: 100%; padding: 14px; border-radius: 12px;
    background: #e5e5e5; color: #3a0d1b; font-weight: bold; text-align: center;
    text-decoration: none; border: none; cursor: pointer; font-size: 16px;
  }
  .btn-tg { background: #229ED9; color: white; }
  .btn-max { background: #8e24aa; color: white; }

  .sheet-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 90;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .sheet-backdrop.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* --- МОБИЛЬНАЯ ВЕРСИЯ --- */
  .mobile-feed { overflow-y: scroll; scroll-snap-type: y mandatory; scroll-snap-stop: always; }
  .mobile-feed .video-slide { height: 100dvh; scroll-snap-align: start; width: 100%; }
  .mobile-feed .action-rail { bottom: 100px; right: 8px; }

  /* --- ДЕСКТОП/ПЛАНШЕТ ВЕРСИЯ --- */
  .desktop-feed {
    display: flex;
    overflow-x: scroll;
    scroll-snap-type: x mandatory;
    scroll-snap-stop: always;
    gap: 24px;
    padding: 0 25vw; 
    align-items: center;
    cursor: grab;
    user-select: none;
  }

  .desktop-feed.active-drag { cursor: grabbing; scroll-snap-type: none !important; }

  .desktop-feed .video-slide {
    flex: 0 0 auto;
    width: 50vw; 
    max-width: 600px;
    height: 85vh; 
    scroll-snap-align: center;
    border-radius: 24px; 
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    transition: filter 0.4s ease, transform 0.4s ease, opacity 0.4s ease;
    filter: blur(8px) brightness(0.6);
    transform: scale(0.92);
    opacity: 0.7;
  }

  .desktop-feed .video-slide.is-active { filter: blur(0) brightness(1); transform: scale(1); opacity: 1; }

  .mobile-feed .slide-video, .mobile-feed .video-slide {
    border-radius: 0;
    filter: none !important;
    transform: none !important;
    opacity: 1 !important;
  }
</style>